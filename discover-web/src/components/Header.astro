---
// src/components/Header.astro
const whatsappUrl = "https://wa.me/51953216828?text=Hola%2C%20quisiera%20agendar%20un%20test%20ride%20de%20la%20Discover%20125%20ST";
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center gap-4">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0 hover:opacity-80 transition-opacity">
      <img src="/logo_discover.svg" alt="Bajaj Discover" class="h-10 w-auto" />
    </a>

    <!-- Menú de Navegación Desktop -->
    <nav class="hidden lg:flex items-center gap-7 font-semibold text-bajaj-blue">
      <a href="/" class="hover:text-bajaj-orange transition-colors">Inicio</a>
      <a href="/discover-125" class="hover:text-bajaj-orange transition-colors">Discover 125</a>
      <a href="/distribuidores" class="hover:text-bajaj-orange transition-colors">Distribuidores</a>

      <!-- Desplegable Garantía -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 hover:text-bajaj-orange transition-colors cursor-pointer py-1"
        >
          <span>Garantía</span>
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Puente invisible (pt-3) para que no se cierre al bajar el mouse -->
        <div class="absolute left-0 top-full pt-3 w-60 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 py-2 overflow-hidden">
            <a
              href="/politica-de-garantias"
              class="block px-5 py-3 text-sm text-bajaj-blue hover:bg-gray-50 hover:text-bajaj-orange transition-colors"
            >
              Política de Garantías
            </a>
            <a
              href="/plan-de-mantenimiento"
              class="block px-5 py-3 text-sm text-bajaj-blue hover:bg-gray-50 hover:text-bajaj-orange transition-colors"
            >
              Plan de Mantenimiento
            </a>
          </div>
        </div>
      </div>

      <a href="/contacto" class="hover:text-bajaj-orange transition-colors">Contacto</a>

      <!-- CTA Test Ride -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-bajaj-orange text-white font-bold py-2.5 px-6 rounded-full hover:bg-orange-600 transition shadow-md text-sm whitespace-nowrap"
      >
        Agenda tu test ride
      </a>
    </nav>

    <!-- Botón Menú Móvil -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menú"
      class="lg:hidden text-bajaj-blue p-2 rounded-lg hover:bg-gray-100 transition"
    >
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Menú Móvil -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 px-6 py-4 space-y-3 font-semibold text-bajaj-blue shadow-md">
    <a href="/" class="block py-2 hover:text-bajaj-orange transition-colors">Inicio</a>
    <a href="/discover-125" class="block py-2 hover:text-bajaj-orange transition-colors">Discover 125</a>
    <a href="/distribuidores" class="block py-2 hover:text-bajaj-orange transition-colors">Distribuidores</a>
    
    <div class="py-2 border-y border-gray-100 space-y-2">
      <span class="block text-xs uppercase tracking-wider text-gray-400 font-bold">Garantía</span>
      <a href="/politica-de-garantias" class="block pl-3 py-1.5 hover:text-bajaj-orange transition-colors">
        Política de Garantías
      </a>
      <a href="/plan-de-mantenimiento" class="block pl-3 py-1.5 hover:text-bajaj-orange transition-colors">
        Plan de Mantenimiento
      </a>
    </div>

    <a href="/contacto" class="block py-2 hover:text-bajaj-orange transition-colors">Contacto</a>

    <!-- CTA Test Ride Móvil -->
    <div class="pt-2">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center bg-bajaj-orange text-white font-bold py-3 px-6 rounded-full hover:bg-orange-600 transition shadow-md"
      >
        Agenda tu test ride
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
---
// src/components/Footer.astro
---

<footer class="bg-bajaj-blue text-white pt-12 lg:pt-16 font-poppins">
  <!-- Bloque Principal: Logo y Redes Sociales -->
  <div class="w-full max-w-6xl mx-auto px-6 flex flex-col lg:flex-row justify-between items-center mb-12 gap-10 lg:gap-0">
    
    <!-- Logo -->
    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
      <img src="/logo_discover.svg" alt="Discover 125 ST" class="w-48 max-w-full h-auto brightness-0 invert" />
    </div>
    
    <!-- Redes Sociales -->
    <div class="flex flex-col items-center lg:items-end gap-4 mt-2 lg:mt-0">
      <span class="text-xs font-bold tracking-widest text-gray-300 uppercase text-center lg:text-right">Nuestra Comunidad</span>
      <div class="flex justify-center gap-4">
        <!-- Facebook -->
        <a href="https://www.facebook.com/EmprendedoresBajaj" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="bg-gray-900/40 p-3 rounded-full hover:bg-bajaj-yellow hover:text-bajaj-blue transition-all duration-300 shadow-sm">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
        </a>
        <!-- Instagram -->
        <a href="https://www.instagram.com/emprendedoresbajaj" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="bg-gray-900/40 p-3 rounded-full hover:bg-bajaj-yellow hover:text-bajaj-blue transition-all duration-300 shadow-sm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <!-- TikTok -->
        <a href="https://www.tiktok.com/@emprendedores.bajaj" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="bg-gray-900/40 p-3 rounded-full hover:bg-bajaj-yellow hover:text-bajaj-blue transition-all duration-300 shadow-sm">
           <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Sección Media: Partners y Libro de Reclamaciones -->
  <div class="w-full max-w-6xl mx-auto px-6 flex flex-col lg:flex-row justify-between items-center pb-10 gap-8 lg:gap-0 border-b border-white/20">
    <div class="flex flex-wrap justify-center items-center gap-8">
      <img src="/crosland-logo.png" alt="Crosland" class="h-10 lg:h-12 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
      <img src="/bajaj-logo.png" alt="Bajaj" class="h-10 lg:h-12 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
    </div>
    
    <a href="https://form.jotform.com/253006979608062" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform duration-300">
      <img src="/libro-reclamaciones.png" alt="Libro de Reclamaciones" class="h-12 lg:h-14 w-auto drop-shadow-md" />
    </a>
  </div>

  <!-- Barra Legal -->
  <div class="bg-gray-900 py-5">
    <div class="w-full max-w-6xl mx-auto px-6 flex flex-col-reverse md:flex-row justify-between items-center gap-4 md:gap-0 text-center md:text-left">
      <p class="text-[11px] text-gray-400 m-0 font-medium tracking-wide uppercase mt-2 md:mt-0">
        © 2026 Grupo UMA / Bajaj Perú. Todos los derechos reservados.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/terminos-y-condiciones" class="text-gray-400 text-[11px] font-bold uppercase hover:text-bajaj-yellow transition-colors tracking-wide">
          Términos y Condiciones
        </a>
      </div>
    </div>
  </div>
</footer>